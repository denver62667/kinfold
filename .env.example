# --- server ---
PORT=3000
SESSION_SECRET=change-me-to-a-random-string

# --- WikiTree (no registration required for public profiles) ---
WIKITREE_APP_ID=kinfold

# Wikidata and Open Archives need no API key — they work out of the box.

# --- Europeana (OPTIONAL: pan-European archives incl. UK/Scotland & Germany) ---
# Free key (no paid tier). Get one at https://pro.europeana.eu/get-api
# Leave blank to keep the Europeana source disabled; the rest of the app still runs.
EUROPEANA_API_KEY=
