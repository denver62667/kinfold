# --- server ---
PORT=3000
# NODE_ENV=production   # set in production (enables proxy trust behind a load balancer)

# Most of Kinfold's sources (Open Archives, Chronicling America, Internet Archive,
# Library of Congress, National Archives UK) are free and need NO API key — the app
# works out of the box with no secrets to set.

# --- OPTIONAL key-gated sources ---
# Each is free; leave blank to keep the source hidden. The rest of the app runs either way.

# DPLA — 50M+ items from US libraries/archives/museums. Request a key:
# https://pro.dp.la/developers/policies
DPLA_API_KEY=

# Trove — National Library of Australia newspapers & gazettes. Request a key:
# https://trove.nla.gov.au/about/create-something/using-api
TROVE_API_KEY=
